name: 当せん番号の自動更新

on:
  schedule:
    # ロト7は月曜、ロト6は月・木の夜に抽せん。翌朝に取りに行く（UTC表記）
    # 日本時間 火・金 の 08:10 = UTC 月・木 23:10
    - cron: '10 23 * * 1,4'
    # 保険としてもう1本（日本時間 水・土 の 08:10）
    - cron: '10 23 * * 2,5'
  workflow_dispatch:        # 手動でも実行できる

permissions:
  contents: write

concurrency:
  group: update-loto
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      # 素の fetch が Akamai に弾かれたときのフォールバック用
      - name: Playwright を用意
        run: |
          npm init -y >/dev/null 2>&1 || true
          npm i -D playwright@latest
          npx playwright install --with-deps chromium

      - name: 最新の当せん番号を取得
        id: fetch
        run: node tools/update-loto.mjs

      - name: 変更があればコミット
        run: |
          if [ -z "$(git status --porcelain data/)" ]; then
            echo "変更なし。コミットしません。"
            exit 0
          fi
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/
          git commit -m "chore(data): 当せん番号を更新 $(date -u +%Y-%m-%d)"
          git push

      # 取得に失敗したら気づけるように Issue を立てる
      - name: 失敗を通知
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            const title = '当せん番号の自動更新に失敗しました';
            const { data: issues } = await github.rest.issues.listForRepo({
              owner: context.repo.owner, repo: context.repo.repo,
              state: 'open', labels: 'auto-update'
            });
            const body = `自動更新ワークフローが失敗しました。\n\n` +
              `みずほ側のCSV形式変更、またはアクセス遮断の可能性があります。\n` +
              `ログ: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}\n\n` +
              `※ data/ は変更していないため、アプリは直前のデータのまま動作します。`;
            if (issues.some(i => i.title === title)) {
              await github.rest.issues.createComment({
                owner: context.repo.owner, repo: context.repo.repo,
                issue_number: issues.find(i => i.title === title).number, body
              });
            } else {
              await github.rest.issues.create({
                owner: context.repo.owner, repo: context.repo.repo,
                title, body, labels: ['auto-update']
              });
            }
